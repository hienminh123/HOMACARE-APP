  <script>
    import { SESSION_STORAGE_KEY } from '../lib/config';

    // Link email Supabase trỏ về trang chủ (Site URL) → chuyển sang trang đăng nhập, giữ nguyên tham số.
    const hash = new URLSearchParams(location.hash.slice(1));
    const search = new URLSearchParams(location.search);
    if (hash.has('access_token') || hash.has('error_code') || search.has('code')) {
      location.replace('/app/dang-nhap/' + location.search + location.hash);
    }

    // Đã có phiên trong trình duyệt này: nút tài khoản dẫn vào app (app tự đưa về đúng không gian theo vai trò).
    try {
      if (localStorage.getItem(SESSION_STORAGE_KEY)) {
        const label = document.querySelector('[data-account-label]');
        if (label) label.textContent = matchMedia('(min-width: 640px)').matches ? 'Vào không gian của bạn' : 'Tài khoản';
      }
    } catch { /* trình duyệt chặn bộ nhớ: giữ nhãn mặc định */ }

    // Hiện dần khi cuộn
    const targets = document.querySelectorAll('[data-reveal]');
    if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('reveal-ready');
      const io = new IntersectionObserver(entries => entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
      }), { rootMargin: '0px 0px -8% 0px' });
      targets.forEach(t => io.observe(t));
    }
  </script>
