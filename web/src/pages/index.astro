---
// Trang giới thiệu "/". Nội dung chuyển từ preview/index.html (landing v4) và Góc sức khỏe
// (docs/noi-dung/goc-suc-khoe.md, đã mở lại 3 link nguồn ngày 13/10/2026), dựng lại bằng design system.
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import JourneySteps from '../components/site/JourneySteps.astro';
import Button from '../components/hc/Button.astro';
import Card from '../components/hc/Card.astro';
import Icon from '../components/hc/Icon.astro';
import StatusPill from '../components/hc/StatusPill.astro';
import StatusTimeline from '../components/hc/StatusTimeline.astro';
import VisitCard from '../components/hc/VisitCard.astro';
import Person from '../components/hc/Person.astro';
import Avatar from '../components/hc/Avatar.astro';
import Chip from '../components/hc/Chip.astro';
import { TASKS } from '../lib/visits';
import '../styles/site.css';

import companion from '../assets/photos/companion.jpg';
import meal from '../assets/photos/meal.jpg';
import walk from '../assets/photos/walk.jpg';
import family from '../assets/photos/family.jpg';
import caregiver from '../assets/photos/caregiver.jpg';

const bookHref = '/app/dang-nhap/?role=family&booking=1';

const values = [
  { title: 'Biết người đang đồng hành', text: 'Xem tên chuyên viên sau khi điều phối viên phân công ca cho người thân.', kind: 'person' },
  { title: 'Biết lịch đã được sắp xếp', text: 'Theo dõi ngày, khung giờ và trạng thái từ chờ phân công đến hoàn thành.', kind: 'status' },
  { title: 'Biết hôm nay có gì đáng chú ý', text: 'Đọc hoạt động, ghi nhận chung và lưu ý cho lần tới sau khi chuyên viên gửi nhật ký.', kind: 'log' },
];

const coreValues = [
  { icon: 'heart', title: 'Tận tâm', text: 'Hỏi kỹ cha mẹ cần gì, thích gì trước khi bắt tay vào việc.' },
  { icon: 'users', title: 'Tôn trọng', text: 'Cha mẹ đồng ý mới làm. Giữ thói quen, để cha mẹ tự làm những việc còn tự làm được.' },
  { icon: 'book', title: 'Rõ ràng', text: 'Nói trước sẽ làm gì, vào giờ nào, và ghi lại sau mỗi buổi.' },
  { icon: 'shield', title: 'Có trách nhiệm', text: 'Làm đúng phần việc đã thống nhất, nhận góp ý để làm tốt hơn.' },
];

const roles = [
  {
    role: 'family' as const, initials: 'GĐ', name: 'Gia đình', title: 'Đặt lịch và dõi theo cha mẹ.',
    text: 'Thêm hồ sơ cha mẹ, gửi yêu cầu, xem ai được phân công, đọc nhật ký và chấm sao sau mỗi buổi.',
    flow: 'Thêm người thân → Gửi yêu cầu → Xem lịch và phân công → Đọc nhật ký gần nhất → Đánh giá ca.',
    cta: 'Vào không gian gia đình', href: '/app/dang-nhap/?role=family',
  },
  {
    role: 'caregiver' as const, initials: 'CV', name: 'Chuyên viên chăm sóc', title: 'Nhận ca và ghi lại buổi chăm sóc.',
    text: 'Xem ca được giao, đọc lưu ý về người thân, bấm bắt đầu khi đến nơi, đánh dấu 4 việc và gửi nhật ký.',
    flow: 'Hỗ trợ bữa tối · Đồng hành vận động nhẹ · Trò chuyện & nhắc lịch sinh hoạt · Kiểm tra an toàn trước khi kết thúc.',
    cta: 'Vào không gian chuyên viên', href: '/app/dang-nhap/?role=caregiver',
  },
  {
    role: 'coordinator' as const, initials: 'ĐP', name: 'Điều phối viên', title: 'Nhận yêu cầu và tìm người phù hợp.',
    text: 'Xem các ca đang chờ, chọn chuyên viên còn trống lịch và theo dõi ca cho đến khi xong.',
    flow: 'Xem danh sách ca → Lọc Chờ phân công → Chọn chuyên viên trống lịch → Xác nhận phân công → Theo dõi tiến độ ca.',
    cta: 'Đăng nhập điều phối', href: '/app/dang-nhap/?role=coordinator',
  },
];

const services = [
  { image: companion, alt: 'Người cao tuổi đọc sách cùng người đồng hành tại nhà', title: 'Trò chuyện và đồng hành', text: 'Nói chuyện, đọc báo, đọc sách hay chơi cờ, tùy cha mẹ thích gì.' },
  { image: meal, alt: 'Người đồng hành cùng người cao tuổi dùng bữa tối', title: 'Bữa ăn và sinh hoạt', text: 'Phụ chuẩn bị bữa, cùng ăn và giúp những việc sinh hoạt cơ bản đã thống nhất trước.' },
  { image: walk, alt: 'Người cao tuổi đi dạo trong vườn cùng người đồng hành', title: 'Vận động nhẹ', text: 'Đi bộ cùng cha mẹ, đỡ khi đi lại trong nhà, vừa sức với từng người.' },
  { image: caregiver, alt: 'Chuyên viên chăm sóc ghi nhật ký sau buổi đồng hành', title: 'Nhắc lịch và ghi nhận', text: 'Nhắc giờ sinh hoạt, ghi lại việc đã làm và gửi nhật ký cho gia đình.' },
];

const upcoming = [
  { name: 'Gói Chăm chút', intro: 'Thêm thời gian hỗ trợ người thân trong các sinh hoạt ban ngày.', price: '600.000–800.000đ / buổi', duration: 'Thời lượng dự kiến: 8–12 giờ / buổi', text: 'Đồng hành trong sinh hoạt ban ngày, hỗ trợ dùng bữa trưa và chiều, theo dõi nề nếp sinh hoạt.' },
  { name: 'Gói Thân tình', intro: 'Định hướng đồng hành định kỳ để gia đình chủ động sắp xếp trong tháng.', price: '2.800.000đ / tháng', duration: 'Dự kiến: 7 ngày lựa chọn/tháng · 8 giờ/ngày', text: 'Gói đồng hành định kỳ hàng tháng giúp người thân có người quen thuộc đồng hành đều đặn.' },
];

const quality = [
  { icon: 'user-check', title: 'Tuyển chọn phù hợp', text: 'Dự kiến kiểm tra thông tin, kinh nghiệm và độ phù hợp với việc chăm sóc tại nhà trước khi nhận.' },
  { icon: 'book', title: 'Đào tạo căn bản', text: 'Dự kiến chương trình 30 giờ về giao tiếp, hỗ trợ sinh hoạt, vận động an toàn và nhận biết tình huống cần hỗ trợ.' },
  { icon: 'users', title: 'Có đầu mối điều phối', text: 'Mỗi ca đều có điều phối viên theo dõi, nên gia đình luôn biết cần hỏi ai.' },
];

const done = [
  'Webapp chạy thật với 3 không gian riêng cho gia đình, chuyên viên và điều phối viên.',
  'Đặt được gói Ân cần, theo dõi 4 trạng thái ca, đọc nhật ký và chấm sao sau mỗi buổi.',
  'Quyền xem dữ liệu được kiểm tra trên máy chủ, có 28 bài kiểm thử tự động.',
];
const next = [
  'Thử nghiệm với gia đình và chuyên viên thật tại một khu vực ở Hà Nội.',
  'Tuyển chọn chuyên viên, xây dựng chương trình đào tạo căn bản 30 giờ.',
  'Mở đặt gói Chăm chút và Thân tình, thêm thanh toán trực tuyến và thông báo.',
];

// Đã mở lại từng link ngày 13/10/2026: cả ba còn hoạt động.
const articles = [
  { image: walk, alt: 'Người cao tuổi và người đồng hành đi dạo trong khu vườn', source: 'Việt Nam · Cục Dân số', date: '30/09/2026', title: 'Ngày Quốc tế Người cao tuổi: nhìn lại cách chúng ta đồng hành', text: 'Bài viết về chủ đề năm 2026 và những điều kiện giúp người cao tuổi có cuộc sống khỏe mạnh, có phẩm giá.', href: 'https://vnpa.moh.gov.vn/ngay-quoc-te-nguoi-cao-tuoi-1-thang-10/' },
  { image: family, alt: 'Người cha và con gái cùng xem điện thoại', source: 'Thế giới · WHO Đông Nam Á', date: '01/10/2026', title: 'Cùng xây dựng hệ thống hỗ trợ cho cuộc sống dài hơn', text: 'WHO chia sẻ về già hóa khỏe mạnh và sự phối hợp giữa y tế, cộng đồng và hỗ trợ xã hội. Bài viết bằng tiếng Anh.', href: 'https://www.who.int/southeastasia/news/detail/01-10-2026-healthy-ageing-2026' },
  { image: companion, alt: 'Người cao tuổi trò chuyện và đọc sách cùng người đồng hành', source: 'Kiến thức nền · WHO', date: '01/10/2025', title: 'Già hóa và sức khỏe: hiểu nhu cầu ở mỗi giai đoạn', text: 'Tổng quan về già hóa dân số và cách tạo môi trường hỗ trợ người cao tuổi. Bài viết bằng tiếng Anh.', href: 'https://www.who.int/news-room/fact-sheets/detail/ageing-and-health' },
];

const faqs = [
  { q: 'HomaCare phù hợp với gia đình nào?', a: 'Gia đình có cha mẹ lớn tuổi cần thêm người bầu bạn hoặc giúp một phần việc sinh hoạt, trong khi con cái không ở gần. Trước ca đầu tiên, bạn nên trao đổi với HomaCare để xem có phù hợp không.' },
  { q: 'Cha mẹ có cần dùng ứng dụng không?', a: 'Gia đình có thể dùng tài khoản của mình để thêm người thân, đặt ca và theo dõi nhật ký. Người cao tuổi không cần tự thao tác trên app; gia đình vẫn cần trao đổi để người thân hiểu và đồng ý với buổi đồng hành.' },
  { q: 'Hiện tôi có thể đặt gói nào?', a: 'Ứng dụng hiện hỗ trợ gửi yêu cầu ca Ân cần, từ 18:00 đến 22:00, kéo dài 4 giờ. Gói Chăm chút và Thân tình đang được phát triển; bạn có thể liên hệ để trao đổi nhu cầu.' },
  { q: 'Giá ca Ân cần và thanh toán như thế nào?', a: 'Giá đang hiển thị là 320.000đ/buổi, là mức đề xuất cho giai đoạn thử nghiệm. Bạn được xem lại thông tin và giá trước khi gửi yêu cầu. App hiện chưa có thanh toán trực tuyến; bước gửi yêu cầu chưa thu tiền.' },
  { q: 'Gửi yêu cầu xong có chuyên viên ngay không?', a: 'Yêu cầu được chuyển sang trạng thái Chờ phân công. Điều phối viên tiếp nhận và sắp xếp chuyên viên; khi phân công xong, tên chuyên viên sẽ xuất hiện trong lịch. Bạn có thể bấm Cập nhật để xem thông tin mới.' },
  { q: 'Tôi ở xa thì theo dõi bằng cách nào?', a: 'Bạn xem ngày, giờ, trạng thái và chuyên viên trong Lịch chăm sóc. Sau khi ca hoàn thành, đọc Nhật ký chăm sóc gần nhất và đánh giá từ 1 đến 5 sao. Bấm Cập nhật để tải thông tin mới.' },
  { q: 'HomaCare có cung cấp chăm sóc y tế không?', a: 'HomaCare hiện tập trung đồng hành và hỗ trợ sinh hoạt phi y tế. Khám, chẩn đoán, kê đơn, thay đổi thuốc, tiêm truyền, thủ thuật và phục hồi chức năng chuyên môn nằm ngoài phạm vi dịch vụ hiện tại.' },
  { q: 'Tôi muốn đổi lịch hoặc phản ánh vấn đề thì làm gì?', a: 'Liên hệ HomaCare qua số 0338 031 425 hoặc email homacare@gmail.com. Khi trao đổi, cho biết người thân, ngày chăm sóc và nội dung cần hỗ trợ. App hiện chưa có chức năng tự đổi hoặc hủy ca.' },
  { q: 'HomaCare có phục vụ ở khu vực của gia đình tôi không?', a: 'Giai đoạn đầu, HomaCare dự kiến thử nghiệm ở một khu vực tại Hà Nội. Khi liên hệ, bạn cho biết địa chỉ của cha mẹ để chúng tôi xác nhận có sắp xếp được không.' },
];
---
<BaseLayout title="HomaCare · Chăm sóc người cao tuổi tại nhà, dõi theo từ xa">
  <SiteHeader />

  <main>
    <!-- Hero -->
    <section class="hero" id="hero">
      <div class="site-container hero__grid">
        <div class="hero__copy">
          <h1 class="hero__title">Bạn ở xa.<br /><span>Sự quan tâm vẫn ở gần.</span></h1>
          <p class="hero__lead">HomaCare kết nối gia đình với chuyên viên chăm sóc tại địa phương, sắp xếp những buổi đồng hành bên người thân và ghi nhận hoạt động sau mỗi ca. Để cha mẹ được hỗ trợ trong ngôi nhà quen thuộc, còn bạn vẫn có thể dõi theo từ xa.</p>
          <p class="hero__slogan">Gửi trọn quan tâm, vẹn tròn đạo hiếu.</p>
          <div class="hero__actions">
            <Button href={bookHref} variant="accent" size="lg" iconEnd="arrow-right">Đặt ca chăm sóc</Button>
            <Button href="#how-it-works" variant="secondary" size="lg">Xem cách sử dụng</Button>
          </div>
        </div>
        <div class="hero__demo" aria-label="Minh họa không gian gia đình">
          <VisitCard label="Ca sắp tới" status="assigned" date="Thứ Sáu, 16/10" meta="18:00–22:00 · Gói Ân cần · 320.000đ" caregiver="Nguyễn Thanh Trúc" />
          <Card class="hero__log">
            <div class="hc-card__head"><span class="hc-card__label">Nhật ký mới · 09/10</span><StatusPill status="completed" size="sm" /></div>
            <p class="hc-log__note">Bác dùng bữa ngon miệng, tinh thần vui vẻ. Đã hoàn thành 4 hoạt động và kiểm tra an toàn trước khi ra về.</p>
            <span class="hc-card__meta">4/4 hoạt động · Nguyễn Thanh Trúc</span>
          </Card>
          <p class="demo-flag">Minh họa giao diện · tên người là dữ liệu minh họa</p>
        </div>
      </div>
    </section>

    <!-- Về HomaCare + Dõi theo từ xa: điện thoại xếp "Về HomaCare" lên trước (đã chốt) -->
    <div class="intro-order">
      <section class="site-section site-section--surface values" id="values">
        <div class="site-container">
          <div class="section-head section-head--center" data-reveal>
            <h2>Biết ai đồng hành. Biết ca diễn ra khi nào. Biết những điều cần lưu ý.</h2>
            <p class="section-desc">Sự quan tâm cần những thông tin cụ thể. HomaCare giúp gia đình xem lịch, theo dõi trạng thái và đọc ghi nhận sau buổi chăm sóc trong cùng một không gian.</p>
          </div>
          <div class="grid grid--3">
            {values.map((v, i) => (
              <Card variant="brand" class="value-card" data-reveal style={`--reveal-delay:${i * 140}ms`}>
                <h3 class="value-card__title">{v.title}</h3>
                <p>{v.text}</p>
                <div class="value-card__demo">
                  {v.kind === 'person' && <><strong>Chuyên viên phụ trách:</strong> Nguyễn Thanh Trúc<span>Đã được điều phối viên xác nhận lịch</span></>}
                  {v.kind === 'status' && <><strong>Tiến trình 4 bước</strong><span>Chờ phân công → Đã phân công → Đang chăm sóc → Hoàn thành</span></>}
                  {v.kind === 'log' && <><strong>Nhật ký ca gần nhất:</strong> 4/4 hoạt động<span>Ghi nhận: Bác cười nhiều, tinh thần thoải mái</span></>}
                </div>
              </Card>
            ))}
          </div>
          <div class="section-foot section-foot--center"><Button href="#how-it-works" variant="secondary" iconEnd="chevron-down">Khám phá không gian gia đình</Button></div>
        </div>
      </section>

      <section class="site-section about" id="about">
        <div class="site-container">
          <div class="about__grid">
            <div class="about__text" data-reveal>
              <h2>Bắt đầu từ mong muốn được ở bên cha mẹ.</h2>
              <p>Có những ngày bạn chỉ kịp gọi về sau giờ làm. Có những điều cha mẹ cần giúp đỡ mà một cuộc gọi chưa thể làm thay: một bữa ăn, một buổi đi dạo hay một người ngồi lại lắng nghe.</p>
              <p>HomaCare được hình thành từ trăn trở ấy. Chúng tôi phát triển nền tảng kết nối và điều phối chăm sóc người cao tuổi tại nhà, giúp gia đình sắp xếp sự hỗ trợ tại địa phương và theo dõi những buổi đồng hành qua lịch chăm sóc, nhật ký và phản hồi.</p>
              <p class="about__extra">Người cao tuổi được ở trong không gian quen thuộc, giữ những thói quen của mình. Người con có thêm một cách tham gia vào việc chăm sóc, dù khoảng cách khiến việc có mặt thường xuyên trở nên khó khăn.</p>
              <div class="about__mv">
                <div><strong>Sứ mệnh</strong><p>Giúp gia đình duy trì sự quan tâm từ xa, đồng thời hỗ trợ người cao tuổi sống tự chủ và có người đồng hành ngay tại nhà.</p></div>
                <div><strong>Tầm nhìn</strong><p>Từng bước xây dựng mạng lưới chăm sóc tại địa phương có quy trình rõ ràng, kết nối gia đình, chuyên viên và điều phối viên.</p></div>
              </div>
            </div>
            <div class="about__photo">
              <Image src={companion} alt="Người cao tuổi và người đồng hành đọc sách tại nhà" widths={[480, 720, 960]} sizes="(min-width: 900px) 45vw, 100vw" loading="lazy" />
            </div>
          </div>
          <h3 class="about__values-title">Bốn điều HomaCare luôn giữ</h3>
          <ul class="core-values">
            {coreValues.map((c, i) => (
              <li class="core-value" data-reveal style={`--reveal-delay:${(i % 2) * 140}ms`}>
                <span class="core-value__icon"><Icon name={c.icon} /></span>
                <strong>{c.title}</strong>
                <p>{c.text}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </div>

    <!-- Cách sử dụng -->
    <section class="site-section site-section--warm" id="how-it-works">
      <div class="site-container">
        <div class="section-head" data-reveal>
          <h2>Từ lịch hẹn đầu tiên đến nhật ký sau ca.</h2>
          <p class="section-desc">Sáu bước, từ lúc tạo tài khoản đến lúc đặt buổi tiếp theo. Bấm vào từng bước để xem màn hình tương ứng.</p>
        </div>
        <JourneySteps />
      </div>
    </section>

    <!-- Tính năng -->
    <section class="site-section" id="features">
      <div class="site-container">
        <div class="section-head section-head--center" data-reveal>
